# Project Specific
backend/.data/*
config.yml
homebox.db
homebox.db-journal
homebox.db-shm
homebox.db-wal
.idea
.DS_Store
test-mailer.json
node_modules

*.venv
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Nix build dir
/result

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.task/
backend/.env
build/*

# Output Directory for Nuxt/Frontend during build steps
backend/app/api/public/*
!backend/app/api/public/.gitkeep

node_modules
*.log*
.nuxt
.nitro
.cache
.output
.env
*.local.toml
dist

.pnpm-store
backend/app/api/app
backend/app/api/__debug_bin*
dist/

# Nuxt Publish Dir
backend/app/api/static/public/*
!backend/app/api/static/public/.gitkeep
backend/api

docs/.vitepress/cache/
.data/

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/coverage/

# Playwright CLI local config (machine-specific browser detection)
.playwright/
# Playwright CLI console and page dumps from interactive debugging
.playwright-cli/
frontend/.playwright-cli/
.playwright-mcp/

# Agent skills are vendored so every clone and worktree gets them without a
# fetch step. Everything else under .agents/ is local state.
.agents/*
!.agents/skills/

# Subagent definitions are committed where each tool reads them. The rest of
# .claude/ is per-machine state: symlinked skills, run locks, worktrees.
.claude/*
!.claude/agents/

# Beads issue tracker (fork-only, upstream does not use it)
.beads/
# Raw agent transcripts from the frontend audit. 29MB of never-delta-compressing
# blobs; the audit's conclusions and their provenance are tracked alongside them.
fork/doc-quarantine/audit-2026-08-06/transcripts/

# Agent session scratch. A handoff note is state for the next session, not a
# project document: it is stale the moment its work lands, and the durable parts
# belong in a commit message, an AGENTS.md, or an issue.
HANDOFF.md

# bv (beads viewer) local config and caches
.bv/

# pi-coding-agent local state
.pi/
# br doctor per-run artifacts
.doctor/
