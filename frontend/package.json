    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/markdown-it": "^14.1.0",
    "@vite-pwa/nuxt": "^0.10.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
